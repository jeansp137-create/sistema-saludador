<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_CENTER" spacing="16" styleClass="root-pane" xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.sistemasaludador.SaludadorController">
    <padding>
        <Insets bottom="24" left="28" right="28" top="24"/>
    </padding>

    <Label styleClass="titulo" text="Sistema Saludador"/>
    <Label styleClass="subtitulo" text="Caso de uso: Solicitar saludo (Pedir datos)"/>

    <VBox spacing="8">
        <Label text="Nombre"/>
        <TextField fx:id="nombreField" promptText="Ej. Ana Pérez"/>
    </VBox>

    <VBox spacing="8">
        <Label text="Edad"/>
        <TextField fx:id="edadField" promptText="Ej. 20"/>
    </VBox>

    <VBox spacing="8">
        <Label text="Hora"/>
        <HBox alignment="CENTER_LEFT" spacing="10">
            <ComboBox fx:id="horaCombo" prefWidth="90" promptText="Hora"/>
            <Label text=":"/>
            <ComboBox fx:id="minutoCombo" prefWidth="90" promptText="Min"/>
            <RadioButton fx:id="amRadio" selected="true" text="AM">
                <toggleGroup>
                    <ToggleGroup fx:id="periodoGroup"/>
                </toggleGroup>
            </RadioButton>
            <RadioButton fx:id="pmRadio" text="PM" toggleGroup="$periodoGroup"/>
        </HBox>
    </VBox>

    <Button defaultButton="true" onAction="#onSolicitarSaludo" prefWidth="220" styleClass="boton-principal"
            text="Solicitar saludo"/>

    <Label fx:id="mensajeLabel" wrapText="true" styleClass="mensaje"/>
</VBox>
